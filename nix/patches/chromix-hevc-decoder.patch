diff --git a/media/base/supported_types.cc b/media/base/supported_types.cc
--- a/media/base/supported_types.cc
+++ b/media/base/supported_types.cc
@@ -234,6 +234,17 @@
   if (!IsColorSpaceSupported(type.color_space)) {
     return false;
   }
+
+// Keep color-space validation and the shared Uxr codec restriction above this
+// backend query. Only advertise profiles supported by the bundled SW decoder.
+#if BUILDFLAG(ENABLE_FFMPEG_VIDEO_DECODERS) && BUILDFLAG(USE_PROPRIETARY_CODECS)
+  if (type.profile == HEVCPROFILE_MAIN || type.profile == HEVCPROFILE_MAIN10 ||
+      type.profile == HEVCPROFILE_MAIN_STILL_PICTURE ||
+      type.profile == HEVCPROFILE_REXT ||
+      type.profile == HEVCPROFILE_SCREEN_EXTENDED) {
+    return true;
+  }
+#endif
 
 #if BUILDFLAG(ENABLE_PLATFORM_HEVC)
 #if BUILDFLAG(PLATFORM_HAS_OPTIONAL_HEVC_DECODE_SUPPORT)
@@ -620,7 +631,7 @@
 
 bool IsDecoderBuiltInVideoCodec(VideoCodec codec) {
 #if BUILDFLAG(ENABLE_FFMPEG_VIDEO_DECODERS) && BUILDFLAG(USE_PROPRIETARY_CODECS)
-  if (codec == VideoCodec::kH264) {
+  if (codec == VideoCodec::kH264 || codec == VideoCodec::kHEVC) {
     return true;
   }
 #endif  // BUILDFLAG(ENABLE_FFMPEG_VIDEO_DECODERS) &&
